#! /bin/sh

pgrep -x sxhkd > /dev/null || sxhkd &

xrandr --output HDMI-0 --mode 1920x1080 --rate 100 &
xsetroot -cursor_name left_ptr &
$HOME/.config/polybar/launch.sh &
setxkbmap -layout us,mn -option grp:rctrl_rshift_toggle &
nm-applet &
blueman-applet &
dunst &
feh --bg-fill ~/Pictures/wallpapers/wallhaven-8g8q32.jpg &
picom &
thunar --daemon &
otd-daemon &

bspc monitor -d 1 2 3 4 5 6 7 8 9 

bspc config border_width         2
bspc config window_gap          12

bspc config split_ratio          0.5
bspc config borderless_monocle   true
bspc config gapless_monocle      true
bspc config focus_follows_pointer true
bspc config pointer_motion_interval 10

bspc rule -a Thunar state=floating rectangle=960x640+480+220
bspc rule -a Nwg-look state=floating rectangle=960x640+480+220 
bspc rule -a mpv state=floating rectangle=1280x720+320+180
bspc rule -a feh state=floating rectangle=1280x720+320+180

bspc config normal_border_color   "#3a3f40"
bspc config active_border_color   "#6b9a62"
bspc config focused_border_color  "#8fbf7f"
bspc config presel_feedback_color "#a3cfb0"

