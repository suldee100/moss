#---------------------------------------------------------------------------#
# 							Core / Applications								#
#---------------------------------------------------------------------------#



# Terminal emulator
super + Return
	alacritty
	

# Application launcher
super + d
	rofi -show drun
	
# File manager
super + e
	thunar

# Close focused window
super + q
	bspc node -c
	

# Reload sxhkd keybinds
super + shift + c
	pkill -USR1 -x sxhkd


# Restart bspwm in-place
super + shift + r
	bspc wm -r


# Quit bspwm
super + alt + p
	bspc {quit,wm -r}



#---------------------------------------------------------------------------
#	Navigation & Focus
#---------------------------------------------------------------------------



# Change focus
super + {Left,Down,Up,Right}
	bspc node -f {west,south,north,east}


# Move focused window
super + shift + {Left,Down,Up,Right}
	bspc node -s {west,south,north,east}



#---------------------------------------------------------------------------
#	Layouts & Window States
#---------------------------------------------------------------------------



# Toggle Fullscreen
super + f
	bspc node -t \~fullscreen


# Toggle Floating / Tiling
super + space
	bspc node -t "~{floating,tiled}"

# Expand window outwards
super + alt + {Left,Down,Up,Right}
	bspc node -z {left -20 0, bottom 0 20, top 0 -20, right 20 0}


# Contract window inwards
super + ctrl {Left,Down,Up,Right}
	bspc node -z {right -20 0, top 0 20, bottom 0 -20, left 20 0}



#---------------------------------------------------------------------------
#	Workspaces
#---------------------------------------------------------------------------



# Switch to workspace 1-9
super + {1-9}
	bspc desktop -f '^{1-9}'


# Move focused window to workspace 1-9
super + shift + {1-9}
	bspc node -d '^{1-9}' --follow


# Focus the last workspace
alt + {grave,Tab}
	bspc {node,desktop} -f last



#---------------------------------------------------------------------------
#	Volume controls
#---------------------------------------------------------------------------



# Volume Control via Keyboard Wheel / Media Keys
XF86AudioRaiseVolume
    pactl set-sink-volume @DEFAULT_SINK@ +5%

XF86AudioLowerVolume
    pactl set-sink-volume @DEFAULT_SINK@ -5%

XF86AudioMute
    pactl set-sink-mute @DEFAULT_SINK@ toggle
